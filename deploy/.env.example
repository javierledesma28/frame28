# Copia este fichero a .env EN EL SERVIDOR (/opt/frame28/.env, permisos 600). Nunca en el repo.
# Token del túnel «frame28» de Cloudflare: Zero Trust → Networks → Tunnels → frame28 → Configure (el token del
# comando `cloudflared tunnel run --token …`). Es la única credencial que necesita el runtime.
CLOUDFLARE_TUNNEL_TOKEN=
