  "logos": {
    "primary_dark": "https://t28.io/press-kit/logos/think28-logo-primary-dark.svg",
    "reversed_white": "https://t28.io/press-kit/logos/think28-logo-reversed-white.svg",
    "yellow": "https://t28.io/press-kit/logos/think28-logo-yellow.svg",
    "horizontal": "https://t28.io/press-kit/logos/think28-logo-horizontal.svg",
    "isotipo": "https://t28.io/press-kit/logos/think28-isotipo.svg"
  },
  "logo_rules": {
    "clear_space": "altura de la T del wordmark",
    "min_width_px": 80,
    "isotipo_min_px": 32,
    "no_all_caps": true,
    "no_opacity": true
  },
  "voice": {
    "pillars": [
      "directo",
      "técnico",
      "humano"
